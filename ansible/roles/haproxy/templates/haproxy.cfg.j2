
global
    log /dev/log local0
    log /dev/log local1 notice

    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http

    option httplog
    option dontlognull

    timeout connect 5s
    timeout client 30s
    timeout server 30s

frontend http_frontend
    bind {{ haproxy_bind_address }}:{{ haproxy_frontend_port }}

    default_backend web_backend

backend web_backend
    balance roundrobin

    option httpchk GET {{ haproxy_health_path }}
    http-check expect status {{ haproxy_health_status }}

    default-server inter 3s fall 3 rise 2

{% for server in haproxy_backend_servers %}
    server {{ server.name }} {{ server.address }}:{{ server.port }} check
{% endfor %}

{% if haproxy_stats_enabled | bool %}

frontend stats_frontend
    bind {{ haproxy_stats_bind_address }}:{{ haproxy_stats_port }}
    mode http

    stats enable
    stats uri {{ haproxy_stats_uri }}
    stats refresh {{ haproxy_stats_refresh }}
    stats hide-version

{% endif %}
